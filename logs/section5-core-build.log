Universality.Section5.RuleResponses (rule : Universality.Rule) (base : ℕ) : Prop
Universality.Section5.compositionFamily_infinite {first repeated : Universality.Rule}
  (firstResponses : Universality.Section5.RuleResponses first 19)
  (repeatedResponses : Universality.Section5.RuleResponses repeated 661) :
  (Set.range (Universality.Section5.compositionFamily first repeated)).Infinite
Universality.Section5.RuleResponses.actual_growth_limits {rule : Universality.Rule} {base : ℕ}
  (responses : Universality.Section5.RuleResponses rule base) (base_gt_one : 1 < base) :
  (∀ (n : ℕ),
      Real.log ↑(rule.generation n).edges /
          Real.log
            ↑((rule.generation n).network.fullGraph.dist (rule.generation n).network.source
                (rule.generation n).network.target) =
        58 / 25) ∧
    (∀ (state : Universality.FiniteNetwork.LiveState),
        Filter.Tendsto
          (fun n =>
            Real.log ((rule.generation n).network.conditionalClusterMass (1 / 2) state) /
              Real.log
                ↑((rule.generation n).network.fullGraph.dist (rule.generation n).network.source
                    (rule.generation n).network.target))
          Filter.atTop (nhds (219 / 100))) ∧
      Filter.Tendsto (rule.pivotalLogarithmicGrowth (1 / 2)) Filter.atTop (nhds (7 / 10))
