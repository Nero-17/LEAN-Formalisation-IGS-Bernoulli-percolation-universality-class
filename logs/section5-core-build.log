Universality.FiniteNetwork.heterogeneous_coarse_cell_expectation {outerEdges : ℕ}
  {innerVertices innerEdges : Fin outerEdges → ℕ}
  (S : (edge : Fin outerEdges) → Universality.FiniteNetwork (innerVertices edge) (innerEdges edge)) (p : ℝ)
  (positive : ∀ (edge : Fin outerEdges), 0 < (S edge).reliability p)
  (less : ∀ (edge : Fin outerEdges), (S edge).reliability p < 1) (edge : Fin outerEdges)
  (response :
    Universality.FiniteNetwork.Configuration outerEdges →
      (edge : Fin outerEdges) → Universality.FiniteNetwork.Configuration (innerEdges edge) → ℝ) :
  ∑ configuration,
      (∏ edge, Universality.FiniteNetwork.bernoulliWeight p (configuration edge)) *
        response (Universality.FiniteNetwork.heterogeneousCoarseConfiguration S configuration) edge
          (configuration edge) =
    ∑ coarse,
      (∏ edge, if coarse edge = true then (S edge).reliability p else 1 - (S edge).reliability p) *
        (S edge).conditionalCellResponse p (coarse edge) (response coarse edge)
