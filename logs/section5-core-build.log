Universality.Section5.wheatstone_mass_kernel_aggregation
  (a b c : Matrix Universality.FiniteNetwork.LiveState Universality.FiniteNetwork.LiveState ℝ)
  (σ τ : Universality.FiniteNetwork.LiveState) :
  (∑ configuration,
        if Universality.wheatstoneNetwork.conditioning σ configuration = true then
          Universality.FiniteNetwork.bernoulliWeight (1 / 2) configuration *
            ∑ edge,
              match Universality.wheatstoneNetwork.childState σ configuration edge with
              | some state => ![a, b, b, a, c] edge state τ
              | none => 0
        else 0) /
      Universality.wheatstoneNetwork.conditioningProbability (1 / 2) σ =
    (Universality.Section5.K3real * a + Universality.Section5.K3real * b + Universality.Section5.J3real * c) σ τ
